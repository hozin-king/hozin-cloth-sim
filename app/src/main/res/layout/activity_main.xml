<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F13">

    <android.opengl.GLSurfaceView
        android:id="@+id/glView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bar atas: judul + FPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hozin Cloth Sim"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fpsView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— FPS"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Panel kontrol bawah -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC12141A"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⏸ Jeda" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↺ Reset" />

                <Button
                    android:id="@+id/btnBg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⛏ Gua" />
            </LinearLayout>

            <TextView
                android:id="@+id/faceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face: 1024"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />

            <SeekBar
                android:id="@+id/faceBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/windLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Angin: 0%"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <SeekBar
                android:id="@+id/windBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Warna kain:"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/clothColorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Warna bola:"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:id="@+id/ballColorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geser 1 jari: putar kamera • Cubit 2 jari: zoom"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
